@page "/"
@rendermode InteractiveServer
@using DataManagement.db
@inject DbManager Db

<PageTitle>Объекты недвижимости</PageTitle>

<h1>Объекты недвижимости</h1>

<div class="filters">
    <div class="filter-field">
        <label>Тип объекта</label>
        <select @bind="filterType">
            <option value="">Все</option>
            @foreach (var t in Types)
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>

    <div class="filter-field">
        <label>Статус</label>
        <select @bind="filterStatus">
            <option value="">Все</option>
            @foreach (var s in Statuses)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>

    <div class="filter-field">
        <label>Цена от</label>
        <input type="number" @bind="minPrice" @bind:event="oninput" placeholder="0" />
    </div>

    <div class="filter-field">
        <label>Цена до</label>
        <input type="number" @bind="maxPrice" @bind:event="oninput" placeholder="Без ограничений" />
    </div>

    <div class="filter-field">
        <label>Комнат от</label>
        <input type="number" @bind="minRooms" @bind:event="oninput" placeholder="0" />
    </div>

    <div class="filter-field">
        <label>Лифт</label>
        <select @bind="filterElevator">
            <option value="">Неважно</option>
            <option value="true">Есть</option>
            <option value="false">Нет</option>
        </select>
    </div>

    <button class="reset-btn" @onclick="ResetFilters">Сбросить</button>
</div>

@if (isLoading)
{
    <p class="muted">Загрузка…</p>
}
else if (error != null)
{
    <div class="alert error">Не удалось загрузить данные: @error</div>
}
else if (items.Count == 0)
{
    <div class="alert empty">
        Пока нет ни одного объекта.
        <NavLink href="AddRecord">Добавить первый</NavLink>
    </div>
}
else
{
    <p class="muted">Всего объектов: @items.Count</p>

    <div class="cards">
        @foreach (var item in items)
        {
            <article class="card">
                <header class="card-head">
                    <span class="badge">@item.type</span>
                    <span class="status @StatusClass(item.status)">@item.status</span>
                </header>

                <div class="price">@item.price?.ToString("N0") ₽</div>

                <dl class="props">
                    <div><dt>Площадь</dt><dd>@item.square?.ToString("0.#") м²</dd></div>
                    <div><dt>Комнат</dt><dd>@item.numberOfRooms</dd></div>
                    <div><dt>Этажей</dt><dd>@item.countFloor</dd></div>
                    <div><dt>Лифт</dt><dd>@(item.elevator == true ? "есть" : "нет")</dd></div>
                    <div><dt>Ремонт</dt><dd>@item.repair</dd></div>
                    <div><dt>Адрес</dt><dd>@item.adress</dd></div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(item.description))
                {
                    <p class="desc">@item.description</p>
                }
            </article>
        }
    </div>
}

@code {
    private List<RowRecord> items = [];
    private bool isLoading = true;
    private string? error;

    private string filterType = "";
    private string filterStatus = "";
    private string filterElevator = "";
    private decimal? minPrice;
    private decimal? maxPrice;
    private int? minRooms;

    private static readonly string[] Types = { "коммерческое помещение", "жилое помещение", "дом", "участок" };
    private static readonly string[] Statuses = { "активное", "не активное", "в заморозке" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Db.GetHousing();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<RowRecord> FilteredItems => items.Where(i =>
        (string.IsNullOrEmpty(filterType) || i.type == filterType) &&
        (string.IsNullOrEmpty(filterStatus) || i.status == filterStatus) &&
        (!minPrice.HasValue || i.price >= minPrice) &&
        (!maxPrice.HasValue || i.price <= maxPrice) &&
        (!minRooms.HasValue || i.numberOfRooms >= minRooms) &&
        (string.IsNullOrEmpty(filterElevator) || i.elevator == bool.Parse(filterElevator))
    ).ToList();

    private void ResetFilters()
    {
        filterType = "";
        filterStatus = "";
        filterElevator = "";
        minPrice = null;
        maxPrice = null;
        minRooms = null;
    }

    private static string StatusClass(string? status) => status switch
    {
        "активное" => "status-active",
        "в заморозке" => "status-frozen",
        _ => "status-off"
    };
}
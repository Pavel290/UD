@page "/login"
@rendermode InteractiveServer
@using DataManagement.db
@inject DbManager Db
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Вход в систему</PageTitle>

<div style="max-width: 400px; margin: 40px auto; padding: 24px; border: 1px solid #ddd; border-radius: 12px;">
    <h3 style="margin-bottom: 20px;">Вход в систему</h3>

    <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
            <label>Логин</label>
            <input class="form-control" @bind="login" @bind:event="oninput" placeholder="Например: Login333" />
        </div>

        <div>
            <label>Пароль</label>
            <input class="form-control" type="password" @bind="password" @bind:event="oninput" placeholder="Введите пароль" />
        </div>

        @if (!string.IsNullOrEmpty(error)) {
            <div style="color: #d9534f; font-size: 0.9rem;">@error</div>
        }

        <button class="btn btn-primary" @onclick="HandleLogin">Войти по паролю</button>
        <hr />
        <button class="btn btn-secondary" @onclick="HandleGuestLogin">Продолжить без пароля (Гость)</button>
    </div>
</div>

@code {
    private string login = "";
    private string password = "";
    private string? error;

    private async Task HandleLogin() {
        error = null;
        var user = await Db.Login(login, password);
        if (user != null) {
            if (user.status == "не работает") {
                error = "Доступ запрещен: сотрудник не работает";
                return;
            }
            await Session.StartUserSessionAsync(user);
            Nav.NavigateTo("/");
        } else {
            error = "Неверный логин или пароль";
        }
    }

    private async Task HandleGuestLogin() {
        await Session.StartGuestSessionAsync();
        Nav.NavigateTo("/");
    }
}
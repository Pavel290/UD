@rendermode InteractiveServer
@using DataManagement.db
@inject DbManager Db
@page "/HousingBase"

<h3>Объекты недвижимости</h3>

<div class="action-buttons">
    <NavLink class="action-btn" href="/AddRecord">Добавить объект</NavLink>
</div>

@if (isLoading)
{
    <p class="muted">Загрузка…</p>
}
else if (error != null)
{
    <div class="alert error">Не удалось загрузить данные: @error</div>
}
else if (items.Count == 0)
{
    <div class="alert empty">
        Пока нет ни одного объекта.
        <NavLink href="AddRecord">Добавить первый</NavLink>
    </div>
}
else
{
    <p class="muted">Найдено: @items.Count</p>

    <div class="cards">
        @foreach (var item in items)
        {
            <article class="card">
                <header class="card-head">
                    <span class="badge">@item.type</span>
                    <span class="status @StatusClass(item.status)">@item.status</span>
                </header>

                <div class="price">@item.price?.ToString("N0") ₽</div>

                <dl class="props">
                    <div><dt>Площадь</dt><dd>@item.square?.ToString("0.#") м²</dd></div>
                    <div><dt>Комнат</dt><dd>@item.numberOfRooms</dd></div>
                    <div><dt>Этажей</dt><dd>@item.countFloor</dd></div>
                    <div><dt>Лифт</dt><dd>@(item.elevator == true ? "есть" : "нет")</dd></div>
                    <div><dt>Ремонт</dt><dd>@item.repair</dd></div>
                    <div><dt>Адрес</dt><dd>@item.adress</dd></div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(item.description))
                {
                    <p class="desc">@item.description</p>
                }
            </article>
        }
    </div>
}

@code {
    private List<RowRecord> items = [];
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Db.GetHousing();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string StatusClass(string? status) => status switch
    {
        "активное" => "status-active",
        "в заморозке" => "status-frozen",
        _ => "status-off"
    };
}
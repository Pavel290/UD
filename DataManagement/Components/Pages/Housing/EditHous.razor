@page "/EditHous/{Id:int}"
@rendermode InteractiveServer
@using DataManagement.db
@inject DbManager Db
@inject NavigationManager Nav

<div class="form-card">
    <h3>Редактирование объекта недвижимости</h3>

    @if (isLoading) {
        <p class="muted">Загрузка…</p>
    } else if (error != null) {
        <div class="alert error">@error</div>
        <NavLink class="btn-back" href="/HousingBase">← К списку объектов</NavLink>
    } else {
        <EditForm Model="Model" OnValidSubmit="Submit" FormName="EditHous">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-2">
                <label>
                    Тип объекта:
                    <InputSelect @bind-Value="Model.type">
                        <option value="">— выберите —</option>
                        @foreach (var t in Types) {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </label>
                <ValidationMessage For="() => Model.type" />
            </div>

            <div class="mb-2">
                <label>
                    Площадь, м²:
                    <InputNumber @bind-Value="Model.square" />
                </label>
                <ValidationMessage For="() => Model.square" />
            </div>

            <div class="mb-2">
                <label>
                    Цена, ₽:
                    <InputNumber @bind-Value="Model.price" />
                </label>
                <ValidationMessage For="() => Model.price" />
            </div>

            <div class="mb-2">
                <label>
                    Статус:
                    <InputSelect @bind-Value="Model.status">
                        <option value="">— выберите —</option>
                        @foreach (var s in Statuses) {
                            <option value="@s">@s</option>
                        }
                    </InputSelect>
                </label>
                <ValidationMessage For="() => Model.status" />
            </div>

            <div class="mb-2">
                <label>
                    Количество комнат:
                    <InputNumber @bind-Value="Model.numberOfRooms" />
                </label>
                <ValidationMessage For="() => Model.numberOfRooms" />
            </div>

            <div class="mb-2">
                <label>
                    Количество этажей:
                    <InputNumber @bind-Value="Model.countFloor" />
                </label>
                <ValidationMessage For="() => Model.countFloor" />
            </div>

            <div class="mb-2">
                <label>
                    Лифт:
                    <InputSelect @bind-Value="Model.elevator">
                        <option value="">— выберите —</option>
                        <option value="true">Есть</option>
                        <option value="false">Нет</option>
                    </InputSelect>
                </label>
                <ValidationMessage For="() => Model.elevator" />
            </div>

            <div class="mb-2">
                <label>
                    Ремонт:
                    <InputSelect @bind-Value="Model.repair">
                        <option value="">— выберите —</option>
                        @foreach (var r in Repairs) {
                            <option value="@r">@r</option>
                        }
                    </InputSelect>
                </label>
                <ValidationMessage For="() => Model.repair" />
            </div>

            <div class="mb-2">
                <label>
                    Описание:
                    <InputTextArea @bind-Value="Model.description" />
                </label>
                <ValidationMessage For="() => Model.description" />
            </div>

            <div class="mb-2">
                <label>
                    Адрес:
                    <InputText @bind-Value="Model.adress" />
                </label>
                <ValidationMessage For="() => Model.adress" />
            </div>

            <div class="form-actions">
                <button type="submit">Сохранить изменения</button>
                <NavLink class="btn-cancel" href="/HousingBase">Отмена</NavLink>
            </div>

            @if (!string.IsNullOrEmpty(resultMessage)) {
                <div class="result @(isSuccess ? "success" : "error")">@resultMessage</div>
            }
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private RowRecord Model = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool isSuccess;
    private string? error;
    private string? resultMessage;

    private readonly string[] Types =
        ["коммерческое помещение", "жилое помещение", "дом", "участок"];

    private readonly string[] Statuses =
        ["активное", "не активное", "в заморозке"];

    private readonly string[] Repairs =
        ["без ремонта", "косметический", "евроремонт", "дизайнерский"];

    protected override async Task OnParametersSetAsync() {
        isLoading = true;
        error = null;
        resultMessage = null;

        try {
            var found = await Db.GetHous(Id);
            if (found is null)
                error = $"Объект с id={Id} не найден";
            else
                Model = found;
        }
        catch (Exception ex) {
            error = ex.Message;
        }
        finally {
            isLoading = false;
        }
    }

    private async Task Submit() {
        if (isSaving) return;
        isSaving = true;

        try {
            var (ok, message) = await Db.UpdateHous(Model);
            isSuccess = ok;
            resultMessage = ok ? "Изменения сохранены" : message;

            if (ok)
                Nav.NavigateTo("/HousingBase");
        }
        catch (Exception ex) {
            isSuccess = false;
            resultMessage = ex.Message;
        }
        finally {
            isSaving = false;
        }
    }
}